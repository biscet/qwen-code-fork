{
  "name": "@qwen-code/desktop-shell",
  "version": "2.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "npm run build:runtime && tauri build",
    "build:runtime": "node scripts/prepare-runtime.js",
    "bundle:mac:local": "tauri bundle --bundles app,dmg --config src-tauri/tauri.adhoc.conf.json --ci && codesign --verify --deep --strict --verbose=2 src-tauri/target/release/bundle/macos/HomeCode.app",
    "smoke:runtime": "node scripts/smoke-runtime.js",
    "smoke:packaged": "node scripts/smoke-packaged.js",
    "test:release": "node scripts/test-release.js",
    "version": "node scripts/version.js",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.5"
  }
}
